<?xml version="1.0" encoding="utf-8"?>
<!-- Garantiza que nuget.org esté disponible aunque la configuración global de NuGet
     del usuario no tenga ningún origen. No elimina los orígenes que ya existan. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
